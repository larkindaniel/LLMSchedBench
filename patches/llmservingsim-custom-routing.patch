+    @staticmethod
+    def _readonly_request(req_data):
+        value = dict(req_data)
+        value['input_hash_ids'] = tuple(value.get('input_hash_ids', ()))
+        value['output_hash_ids'] = tuple(value.get('output_hash_ids', ()))
+        return MappingProxyType(value)
+
+    @staticmethod
+    def _readonly_prefix_match(sched, req_data):
+        if not sched.enable_prefix_caching:
+            return 0
+        tokens = req_data.get('input_hash_ids', ())[:req_data['input_toks']]
+        cache = sched.memory.npu_prefix_cache
+        node = cache.root_node
+        matched = 0
+        key = tokens
+        with cache._lock:
+            while key:
+                child_key = cache.get_child_key_fn(key)
+                if child_key not in node.children:
+                    break
+                child = node.children[child_key]
+                prefix_len = cache.key_match_fn(child.key, key)
+                matched += prefix_len
+                if prefix_len < len(child.key):
+                    break
+                node = child
+                key = key[prefix_len:]
+        if cache.page_size != 1:
+            matched = matched // cache.page_size * cache.page_size
+        return matched
+
+    def _custom_worker_views(self):
+        requests = self._custom_ready_requests
+        views = []
+        for sched in self.prefill_schedulers:
+            running = sum(len(batch.requests) for batch in sched.inflight)
+            queued_work = 0
+            for req in sched.request:
+                queued_work += max(req.output - req.num_computed_tokens, 0)
+            for batch in sched.inflight:
+                for req in batch.requests:
+                    queued_work += max(req.output - req.num_computed_tokens, 0)
+            capacity = getattr(sched, 'max_num_seqs', 0)
+            if capacity == float('inf'):
+                capacity = 0
+            reuse = {
+                req['request_id']: self._readonly_prefix_match(sched, req)
+                for req in requests
+            }
+            views.append(MappingProxyType({
+                'worker_id': str(sched.instance_id),
+                'waiting_requests': len(sched.request),
+                'running_requests': running,
+                'capacity': int(capacity),
+                'estimated_queued_token_work': queued_work,
+                'reusable_prefix_tokens_by_request': MappingProxyType(reuse),
+            }))
+        return tuple(views)
+
+    def _route_custom_ready_requests(self, current_time_ns):
+        if self.custom_selector is None:
+            raise RuntimeError("CUSTOM routing requires a custom_selector callback")
+        while self._pending_idx < len(self._pending_requests):
+            req_data = self._pending_requests[self._pending_idx]
+            if req_data['arrival_time_ns'] > current_time_ns:
+                break
+            self._custom_ready_requests.append(req_data)
+            self._pending_idx += 1
+
+        if not self._custom_ready_requests:
+            return 0
+        requests = tuple(
+            self._readonly_request(request) for request in self._custom_ready_requests)
+        decisions = self.custom_selector(
+            requests, int(current_time_ns), self._custom_worker_views(), "prefill")
+        if decisions is None:
+            return 0
+        if isinstance(decisions, Mapping):
+            decisions = [decisions]
+
+        ready = {
+            request['request_id']: request for request in self._custom_ready_requests
+        }
+        schedulers = {
+            str(sched.instance_id): sched for sched in self.prefill_schedulers
+        }
+        admitted = set()
+        for decision in decisions:
+            if not decision.get('admit', True):
+                continue
+            request_id = str(decision['request_id'])
+            worker_id = str(decision['worker_id'])
+            if request_id in admitted:
+                raise ValueError(f"duplicate CUSTOM decision for request {request_id}")
+            if request_id not in ready:
