diff --git a/tests/test_custom_router.py b/tests/test_custom_router.py
new file mode 100644
index 0000000000000000000000000000000000000000..7a491a973ee30760cd9fbc8e1834bfc1c534110e
--- /dev/null
+++ b/tests/test_custom_router.py
@@ -0,0 +1,109 @@
+from types import MappingProxyType
+
+import pytest
+
+from serving.core.router import Router
+from llmschedbench.simulator_bridge import PolicyRouter
+
+
+class FakeRequest:
+    def __init__(self, values):
+        self.id = values[0]
+        self.output = values[3]
+        self.num_computed_tokens = 0
+
+
+class FakeScheduler:
+    def __init__(self, instance_id):
+        self.instance_id = instance_id
+        self.model = "model"
+        self.pd_type = None
+        self.max_num_seqs = 1
+        self.enable_prefix_caching = False
+        self.request = []
+        self.inflight = []
+
+    def add_request(self, values, is_init=True):
+        del is_init
+        self.request.append(FakeRequest(values))
+
+
+def pending(request_id):
+    return {
+        "index": request_id,
+        "request_id": f"external-{request_id}",
+        "session_id": f"session-{request_id}",
+        "tenant": "chat",
+        "slo_ns": 1_000_000_000,
+        "input_toks": 10,
+        "output_toks": 20,
+        "arrival_time_ns": 0,
+        "input_hash_ids": [],
+        "output_hash_ids": [],
+    }
+
+
+def test_load_behavior_is_unchanged():
+    schedulers = [FakeScheduler(0), FakeScheduler(1)]
+    router = Router(2, schedulers, 0, routing_policy="LOAD")
+    router._pending_requests = [pending(0), pending(1)]
+
+    assert router.route_arrived_requests(0) == 2
+    assert [len(scheduler.request) for scheduler in schedulers] == [1, 1]
+
+
+class DeferringSelector:
+    def __init__(self):
+        self.calls = 0
+        self.completed = []
+
+    def __call__(self, requests, current_time_ns, workers, role):
+        assert current_time_ns == 0
+        assert role == "prefill"
+        assert isinstance(requests[0], MappingProxyType)
+        assert isinstance(workers[0], MappingProxyType)
+        with pytest.raises(TypeError):
+            requests[0]["tenant"] = "api_batch"
+        request = requests[0]
+        worker = workers[self.calls]
+        self.calls += 1
+        return [{
+            "admit": True,
+            "request_id": request["request_id"],
+            "worker_id": worker["worker_id"],
+        }]
+
+    def on_complete(self, request_id):
+        self.completed.append(request_id)
+
+
+def test_custom_router_exposes_ready_queue_and_can_defer():
+    schedulers = [FakeScheduler(0), FakeScheduler(1)]
+    selector = DeferringSelector()
+    router = Router(
+        2, schedulers, 0, routing_policy="CUSTOM", custom_selector=selector)
+    router._pending_requests = [pending(0), pending(1)]
+
+    assert router.route_arrived_requests(0) == 1
+    assert router.has_pending_requests()
+    assert router.route_arrived_requests(0) == 1
+    assert not router.has_pending_requests()
+    assert [len(scheduler.request) for scheduler in schedulers] == [1, 1]
+
+    router.notify_request_completed(0, 10)
+    assert selector.completed == ["external-0"]
+
+
+def test_llmschedbench_policy_router_dispatches_global_queue():
+    schedulers = [FakeScheduler(0), FakeScheduler(1)]
+    selector = PolicyRouter("least_loaded")
+    router = Router(
+        2, schedulers, 0, routing_policy="CUSTOM", custom_selector=selector)
+    router._pending_requests = [pending(0), pending(1)]
+
+    assert router.route_arrived_requests(0) == 2
+    assert [len(scheduler.request) for scheduler in schedulers] == [1, 1]
+    assert [decision["request_id"] for decision in selector.decisions] == [
+        "external-0",
+        "external-1",
+    ]
