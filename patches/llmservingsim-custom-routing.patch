+            if worker_id not in schedulers:
+                raise ValueError(f"CUSTOM decision references unknown worker {worker_id}")
+            self._add_request_to_scheduler(ready[request_id], schedulers[worker_id])
+            admitted.add(request_id)
+        if admitted:
+            self._custom_ready_requests = [
+                request for request in self._custom_ready_requests
+                if request['request_id'] not in admitted
+            ]
+        return len(admitted)
